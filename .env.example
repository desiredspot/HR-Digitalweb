# Your live domain (no trailing slash) — used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Sanity — create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=f7zm6v26
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Secret used by the Sanity webhook to refresh the blog instantly after you publish
SANITY_REVALIDATE_SECRET=change-me-to-a-long-random-string

# Contact form: where submissions are forwarded (e.g. a GoHighLevel inbound webhook URL)
CONTACT_WEBHOOK_URL=

# Optional: Google Search Console verification code
NEXT_PUBLIC_GSC_VERIFICATION=
